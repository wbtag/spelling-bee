{
  "name": "spelling-bee",
  "private": true,
  "version": "3.0.0",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "pnpm lint:prettier",
    "lint:prettier": "prettier --check .",
    "lintfix": "prettier --write --list-different .",
    "test": "vitest --run",
    "files:create:en": "cd data && ts-node createFiles.ts --locale 'en'",
    "files:create:cs": "cd data && ts-node createFiles.ts --locale 'cs'"
  },
  "prettier": {
    "bracketSameLine": true
  },
  "pre-commit": [
    "test",
    "lintfix"
  ],
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^8.9.2",
    "date-fns": "^2.29.2",
    "element-plus": "^2.14.3",
    "pinia": "^2.3.1",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@types/cli-progress": "^3.11.0",
    "@types/node": "^26.4.1",
    "@types/readline-sync": "^1.4.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.0.2",
    "cli-progress": "^3.11.2",
    "happy-dom": "^20.8.9",
    "pre-commit": "^1.2.2",
    "prettier": "^2.7.1",
    "readline-sync": "^1.4.10",
    "sass": "^1.101.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.5",
    "vite-plugin-checker": "^0.4.9",
    "vitest": "^4.1.10"
  }
}
